# Runtime configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Analyst selection: "stub" replays the flagship advisory for every question;
# "real" runs the bounded LangGraph loop over the corpus tools.
# An unknown value refuses to start rather than silently falling back.
ANALYST_MODE=real

# Model provider.
#   "scripted" replays LLM_SCRIPTED_RESPONSES in order, no network.
#   "openai"   calls any OpenAI-compatible chat-completions endpoint.
# With an empty script, any real call raises ModelError, which the analyst
# turns into a counsel route. See docs/adr/0001-model-provider-seam.md.
LLM_PROVIDER=openai

# JSON list of replies, consumed in order by the scripted model.
# Example: ["hello", "world"]
LLM_SCRIPTED_RESPONSES=

# Shared defaults used when an agent-specific value below is unset.
# Base URLs end at /v1 (or /v1beta); /chat/completions is appended by the client.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=

# Optional per-agent overrides. Keep credentials local; use your own keys.
# Analyst example: OpenRouter / Qwen.
ANALYST_LLM_BASE_URL=https://openrouter.ai/api/v1
ANALYST_LLM_MODEL=qwen/qwen3.5
ANALYST_LLM_API_KEY=
# Verifier example: Gemini's OpenAI-compatible endpoint.
VERIFIER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VERIFIER_LLM_MODEL=gemini-3.1-flash-lite
VERIFIER_LLM_API_KEY=

# Simulated pipeline latency in seconds. 0 for live mode; the load-test report
# was produced at 0.15 (see docs/load-test-report.md §2).
PIPELINE_DELAY_SECONDS=0

# OpenTelemetry distributed tracing endpoint (Jaeger / OTLP gRPC).
# Uncomment when running Jaeger locally (e.g. docker compose up -d jaeger):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Reserved; the run queue is currently in-process.
REDIS_URL=redis://localhost:6379/0
