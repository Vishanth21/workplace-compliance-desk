# Runtime configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Analyst selection: "stub" replays the flagship advisory for every question;
# "real" runs the bounded LangGraph loop over the corpus tools.
# An unknown value refuses to start rather than silently falling back.
ANALYST_MODE=real

# Model provider.
#   "scripted" replays LLM_SCRIPTED_RESPONSES in order, no network.
#   "openai"   calls any OpenAI-compatible chat-completions endpoint.
# With an empty script, any real call raises ModelError, which the analyst
# turns into a counsel route. See docs/adr/0001-model-provider-seam.md.
LLM_PROVIDER=openai

# JSON list of replies, consumed in order by the scripted model.
# Example: ["hello", "world"]
LLM_SCRIPTED_RESPONSES=

# Required when LLM_PROVIDER=openai. LLM_BASE_URL must include /v1 (or /v1beta).
# Gemini's OpenAI-compatible endpoint:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
# Get a key at https://aistudio.google.com/apikey
LLM_API_KEY=

# Simulated pipeline latency in seconds. 0 for live mode; the load-test report
# was produced at 0.15 (see docs/load-test-report.md §2).
PIPELINE_DELAY_SECONDS=0

# Reserved; the run queue is currently in-process.
REDIS_URL=redis://localhost:6379/0
