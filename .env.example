# Runtime configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Analyst selection: "stub" (default) replays the flagship advisory for every
# question; "real" runs the bounded LangGraph loop over the corpus tools.
# An unknown value refuses to start rather than silently falling back.
ANALYST_MODE=stub

# Model provider.
#   "scripted" (default) replays LLM_SCRIPTED_RESPONSES in order, no network.
#   "openai"   calls any OpenAI-compatible chat-completions endpoint.
# With an empty script, any real call raises ModelError, which the analyst
# turns into a counsel route. See docs/adr/0001-model-provider-seam.md.
LLM_PROVIDER=scripted

# JSON list of replies, consumed in order by the scripted model.
# Example: ["hello", "world"]
LLM_SCRIPTED_RESPONSES=

# Required when LLM_PROVIDER=openai. LLM_BASE_URL must include /v1.
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=replace-with-valid-key

# Reserved; the run queue is currently in-process.
REDIS_URL=redis://localhost:6379/0
